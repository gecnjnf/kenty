# Discord Developer Portal -> Bot -> Reset Token (keep private)
DISCORD_BOT_TOKEN=

# OpenAI API key (API usage is billed separately from ChatGPT plans)
OPENAI_API_KEY=

# Optional: default model
OPENAI_MODEL=gpt-4o-mini

# Optional: voice settings
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+8%
TTS_PITCH=+28Hz
